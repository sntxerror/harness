{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ultimate-pi/AgentProfileV1.schema.json",
  "title": "AgentProfileV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "systemPromptRef",
    "modelClass",
    "thinking",
    "tools",
    "skills",
    "mcpServers",
    "permissionProfile",
    "outputContract"
  ],
  "properties": {
    "version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
    "systemPromptRef": { "type": "string", "minLength": 1 },
    "modelClass": { "type": "string", "minLength": 1 },
    "thinking": { "enum": ["off", "minimal", "low", "medium", "high", "xhigh", "max"] },
    "tools": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "skills": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "mcpServers": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "permissionProfile": { "type": "string", "minLength": 1 },
    "outputContract": { "type": "string", "minLength": 1 },
    "maxTurns": { "type": "integer", "minimum": 1 },
    "access": { "enum": ["read_only", "write"] }
  }
}
