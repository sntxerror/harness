{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "permissionReviewLog": true,
  "doublePressToConfirm": true,
  "shellTools": {
    "interactive_shell": {
      "commandArgument": "command",
      "workdirArgument": "cwd"
    }
  },
  "permission": {
    "*": "allow",
    "path": {
      "*": "allow",
      "*.env": "ask",
      "*.env.*": "ask",
      "*.env.example": "allow",
      "~/.ssh/*": "ask",
      "~/.aws/*": "ask",
      "~/.gnupg/*": "ask"
    },
    "bash": {
      "*": "allow",
      "rm *": "ask",
      "rmdir *": "ask",
      "sudo *": "ask",
      "doas *": "ask",
      "su": "ask",
      "su *": "ask",
      "git clean *": "ask",
      "git reset --hard*": "ask",
      "git restore *": "ask",
      "git checkout -- *": "ask",
      "git push *--force*": "ask",
      "git branch -D *": "ask",
      "git stash drop*": "ask",
      "git stash clear*": "ask",
      "chmod -R *": "ask",
      "chown -R *": "ask",
      "truncate *": "ask",
      "dd *": "ask",
      "mkfs*": "ask",
      "docker system prune*": "ask",
      "docker volume rm *": "ask",
      "kubectl delete *": "ask",
      "terraform destroy*": "ask",
      "claude *": "ask",
      "codex *": "ask",
      "antigravity *": "ask",
      "sh": "ask",
      "bash": "ask"
    },
    "external_directory": {
      "*": "ask",
      "/tmp/*": "allow",
      "/var/tmp/*": "allow"
    }
  }
}
