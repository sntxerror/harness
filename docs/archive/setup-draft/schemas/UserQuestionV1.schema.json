{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ultimate-pi/UserQuestionV1.schema.json",
  "title": "UserQuestionV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "runId", "questionId", "prompt", "sensitivity", "status"],
  "properties": {
    "version": { "const": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "questionId": { "type": "string", "minLength": 1 },
    "prompt": { "type": "string", "minLength": 1 },
    "choices": { "type": "array", "items": { "type": "string" } },
    "sensitivity": { "enum": ["normal", "approval", "credential", "destructive"] },
    "deadline": { "type": ["string", "null"], "format": "date-time" },
    "operationHash": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
    "status": { "enum": ["pending", "answered", "expired", "cancelled"] },
    "answer": { "type": ["string", "null"] },
    "answeredBy": { "type": ["string", "null"] },
    "answeredAt": { "type": ["string", "null"], "format": "date-time" }
  }
}
